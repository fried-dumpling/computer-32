; =====================================================================
;  int.hsm : shared macros of the interrupt tests (program/test/interrupt/int_*.asm)
;  run them with tools/dsim/inttest.py on components/computer-32-test.dig.
;  the emulator has no interrupts.
;
;  the runner pulses the IPU input line IRQ (top-level In "I-in", bit IRQ).
;  a program that takes it calls INTVEC() so that int_vec[IRQ] = handler
;  and int_pri[IRQ] = IRQ_LEV. the handler is still at address 8 (jmp main ;
;  nop ; handler), the layout from the old bench that drove INT_vec = 8.
; =====================================================================
#ifndef INT_HSM
#define INT_HSM 1

#define IRQ 3                   ; I-in bit the runner pulses
#define IRQ_LEV 1               ; its level, so int-level in the handler = 0x91
#define PKER 0x80               ; int_pri ker bit: the handler runs in kernel (else it enters as user)

#define IO_BASE 0x4000000
#define TERM_OUT 12
#define ISTACK 0x2000           ; istack before the interrupt
#define SENT 0x5A5A5A5A         ; words around ISTACK start as this

#macro LSET 2
    set #1.S16H, ((#2) >> 16) & 0xFFFF
    set #1.16L, (#2) & 0xFFFF
#end

#macro PUTC 1
    set gen[20].32B, #1
    st.gen[24] gen[20].32B, TERM_OUT
#end

; print without touching gen[20] or the flags (for handlers that return)
#macro HPUTC 1
    set gen[22].32B, #1
    st.gen[24] gen[22].32B, TERM_OUT
#end

#macro HEXD 1
    mov gen[20].32B, gen[1].32B
    shiftri gen[20].32B, #1
    bnd gen[20].32B, gen[18].32B
    cmpi gen[20].32B, 10
    jmp.neg zero.32B, ##num
    addi gen[20].32B, 'A'-10-'0'
##num:
    addi gen[20].32B, '0'
    st.gen[24] gen[20].32B, TERM_OUT
#end

; print gen[1] as 8 hex digits and a space
#macro PHEX 0
    set gen[18].32B, 0xF
    HEXD(28)
    HEXD(24)
    HEXD(20)
    HEXD(16)
    HEXD(12)
    HEXD(8)
    HEXD(4)
    HEXD(0)
    PUTC(' ')
#end

; the CPU starts in kernel with mask 1 (int-level 0x90): run the tests at
; kernel, mask 0, level 0 so IRQs are accepted
#macro INIT 0
    set stack.32B, 0x3000
    LSET(gen[24], IO_BASE)
    set gen[20].32B, 0x80
    stexp gen[20].32B, intlevel
#end

; istack = ISTACK, with SENT in the words around it. the return PC must
; land in ISTACK-4 and nothing else may change (ISA.md 2.2)
#macro INITIST 0
    LSET(gen[1], SENT)
    st.zero gen[1].32B, ISTACK-8
    st.zero gen[1].32B, ISTACK-4
    st.zero gen[1].32B, ISTACK
    set gen[1].32B, ISTACK
    stexp gen[1].32B, istack
#end

; int_vec[IRQ] = handler, int_pri[IRQ] = PKER + IRQ_LEV (uses gen[1])
#macro INTVEC 0
    set gen[1].32B, handler
    interst gen[1].32B, 0, vec | IRQ
    interst zero.32B, PKER + IRQ_LEV, pri | IRQ
#end

; print "<istack> <mem[ISTACK-4]> <mem[ISTACK]> <int-level> "
#macro DUMPINT 0
    ldexp gen[1].32B, istack
    PHEX()
    ld.zero gen[1].32B, ISTACK-4
    PHEX()
    ld.zero gen[1].32B, ISTACK
    PHEX()
    ldexp gen[1].32B, intlevel
    PHEX()
#end

; ---------------------------------------------------------------------
;  handler log. a linked list of LOGN entries {value, next} at LOG, LOGP =
;  next free entry. a handler appends with LOGK (value in gen[22]), using
;  only gen[22], gen[23], ld/st/ldexp/mov/set: no ALU, so the flags of the
;  interrupted code survive. main prints it at the end with DUMPLOG:
;  "G<v> <v> ... g".
; ---------------------------------------------------------------------
#define IRQ2 4                  ; second I-in bit (nested tests)
#define IRQ2_LEV 2
#define LOGP 0x27F0
#define LOG 0x2800
#define LOGN 32

#macro LOGINIT 0
    set gen[1].32B, LOG
    st.zero gen[1].32B, LOGP
##lp:
    mov gen[2].32B, gen[1].32B
    addi gen[2].32B, 8
    st.gen[1] gen[2].32B, 4
    mov gen[1].32B, gen[2].32B
    cmpi gen[1].32B, LOG+8*LOGN
    ijmp.zero zero.32B, ##lp
#end

#macro LOGK 0
    ld.zero gen[23].32B, LOGP
    st.gen[23] gen[22].32B, 0
    ld.gen[23] gen[23].32B, 4
    st.zero gen[23].32B, LOGP
#end

; append mem[istack] (the return PC right after entry)
#macro LOGRET 0
    ldexp gen[22].32B, istack
    ld.gen[22] gen[22].32B, 0
    LOGK()
#end

#macro LOGEXT 1
    ldexp gen[22].32B, #1
    LOGK()
#end

#macro LOGREG 1
    mov gen[22].32B, #1
    LOGK()
#end

; int_vec[#2] = #1, int_pri[#2] = #3 (uses gen[1])
#macro SETVEC 3
    set gen[1].32B, #1
    interst gen[1].32B, 0, vec | #2
    interst zero.32B, #3, pri | #2
#end

; print the log (uses gen[1], gen[2], gen[18], gen[19], gen[20])
#macro DUMPLOG 0
    PUTC('G')
    set gen[19].32B, LOG
##lp:
    ld.zero gen[2].32B, LOGP
    cmp gen[19].32B, gen[2].32B
    jmp.zero zero.32B, ##end
    ld.gen[19] gen[1].32B, 0
    PHEX()
    addi gen[19].32B, 8
    jmp.one zero.32B, ##lp
##end:
    PUTC('g')
#end

; print label addresses: "L<#1> "
#macro PADDR 1
    set gen[1].32B, #1
    PHEX()
#end

#end
